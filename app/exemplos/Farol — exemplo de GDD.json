                "duration": null
              },
              {
                "id": "5f870e27-2f6e-4dc8-97b8-212fb2665086",
                "type": "item",
                "text": "O final da campanha revela quem acendeu o farol pela primeira vez.",
                "highlight": "spoiler"
              }
            ]
          }
        ]
      },
